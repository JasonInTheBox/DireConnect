# packages/db/.env.example
# Runtime apps use DATABASE_URL. DIRECT_URL is optional and is used by Prisma CLI commands when set.
# If omitted, prisma.config.ts falls back to DATABASE_URL.
DATABASE_URL="your-pooled-runtime-database-url"
DIRECT_URL="your-direct-or-session-pooler-database-url-for-prisma-cli"
