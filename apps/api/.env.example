# Express API local environment

PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://localhost:6379

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Comma-separated exact browser origins when multiple domains are active.
CLIENT_URL=http://localhost:3000

# In production, only listed Supabase Auth user IDs can queue campaigns.
CAMPAIGN_SENDER_ALLOWLIST=

# Shared secret for GET /api/keepalive (daily GitHub Actions ping). Generate a long random value;
# leave empty to disable the endpoint. Set the same value as the KEEPALIVE_TOKEN repository secret.
KEEPALIVE_TOKEN=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
