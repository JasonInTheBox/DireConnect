# BullMQ worker local environment

NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://localhost:6379

# In production, only listed Supabase Auth user IDs can send campaigns.
CAMPAIGN_SENDER_ALLOWLIST=

APP_URL=http://localhost:4000

# Keep fake locally; use resend only when intentionally testing email delivery.
MESSAGE_MODE=fake
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=promotions@direconnect.app

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
