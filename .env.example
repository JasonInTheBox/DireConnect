# Consolidated local-development reference. Each workspace reads its own .env file.

NODE_ENV=development
PORT=4000

# Use a pooled URL at runtime and a direct or session-mode URL for Prisma CLI operations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

REDIS_URL=redis://localhost:6379

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Browser-visible variables used by apps/web. NEXT_PUBLIC_* values are embedded at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Comma-separated exact browser origins when multiple domains are active.
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:4000

# In production, campaign delivery is limited to these approved Supabase Auth user IDs.
# Add the same comma-separated IDs to the Render API and Railway worker environments.
CAMPAIGN_SENDER_ALLOWLIST=

# The worker defaults to fake delivery locally. Resend values are used only with MESSAGE_MODE=resend.
MESSAGE_MODE=fake
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=promotions@direconnect.app

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional Vercel build-time source-map upload settings; leave unset to disable upload.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
